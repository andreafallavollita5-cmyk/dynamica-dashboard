# General
CLIENT_NAME=Dynamica Retail
USE_YESTERDAY_AS_END_DATE=true
TIMEZONE=Europe/Rome

# Dashboard
DASHBOARD_PASSWORD=
# Keep false in Streamlit Cloud. Enable only on the company PC for visual checks.
LOCAL_VERIFICATION_MODE=false

# Google Sheet manual input
GOOGLE_SHEET_ENABLED=true
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET_NAME=manual_inputs
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=service_account_google_sheet.json
GOOGLE_SHEET_REFRESH_SECONDS=3600
# Il write-back usa manual_inputs; Mapping campagne-crm resta sempre in lettura.
GOOGLE_SHEET_MAPPING_WORKSHEET_NAME=Mapping campagne-crm
CRM_EXPORT_PATH=data/input/LEAD QUESTO MESE PULITE.xlsx

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_SECRETS_PATH=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONFIG_PATH=google-ads.yaml
GOOGLE_ADS_DB_PATH=data\google_ads.db

# Meta Ads
META_APP_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v25.0

# Dynamics / Dataverse
DYNAMICS_ENABLED=false
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT_URL=
DYNAMICS_LEAD_TABLE=
DYNAMICS_CAMPAIGN_FIELD=

# GitHub publishing
GITHUB_PUBLISH_ENABLED=false
GITHUB_BRANCH=main
GITHUB_COMMIT_MESSAGE_PREFIX=Aggiornamento dati Dynamica

# Local archive
LOCAL_ARCHIVE_ENABLED=true
LOCAL_ARCHIVE_DIR=archive
